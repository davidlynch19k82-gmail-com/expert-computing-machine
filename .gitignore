import math

class LatticePatternAI:
    def __init__(self):
        # Known historical baseline states stored as fingerprint vectors
        self.knowledge_base = {
            "FRAME_747_CASCADE_PEAK": {1: 1.0, 5: 1.0, 7: 1.0, 13: 1.0, 34: 0.48},
            "FRAME_749_SELF_CONTACT": {1: 1.0, 5: 0.95, 7: 0.0, 13: 0.88, 21: 0.61},
            "FRAME_750_MIRROR_SINGULARITY": {1: 1.0, 5: 0.9542, 7: -0.4219, 13: 0.8841, 21: 0.6180, 34: 0.48, 55: 0.3820}
        }
        logger.info("[AI CORE] Model weights anchored. Awaiting sequence recognition profiles.")

    def calculate_cosine_similarity(self, vec_a, vec_b):
        # Intersect keys to find shared dimensional footprints
        shared_keys = set(vec_a.keys()).intersection(set(vec_b.keys()))
        if not shared_keys:
            return 0.0
        
        dot_product = sum(vec_a[k] * vec_b[k] for k in shared_keys)
        magnitude_a = math.sqrt(sum(val**2 for val in vec_a.values()))
        magnitude_b = math.sqrt(sum(val**2 for val in vec_b.values()))
        
        if max(magnitude_a, magnitude_b) == 0:
            return 0.0
        return dot_product / (magnitude_a * magnitude_b)

    def analyze_frame_matrix(self, nodes):
        # Convert active nodes array into a flat tracking dictionary
        active_vector = {n.get("dim_index"): n.get("amplitude", 0.0) for n in nodes if n.get("dim_index") in [1, 5, 7, 13, 21, 34, 55, 89]}
        
        highest_match = None
        highest_score = 0.0
        
        for state_name, baseline_vector in self.knowledge_base.items():
            score = self.calculate_cosine_similarity(active_vector, baseline_vector)
            if score > highest_score:
                highest_score = score
                highest_match = state_name
                
        # Confidence Threshold: 92% match limits structural false-positives
        if highest_score >= 0.92:
            return {
                "detected": True,
                "profile_name": highest_match,
                "confidence": round(highest_score * 100, 2),
                "action": "RECURSIVE_LOOP_TRIGGERED"
            }
        return {"detected": False, "profile_name": "UNKNOWN_EVOLUTIONARY_STATE", "confidence": 0.0, "action": "STABLE_TRACKING"}

# Instantiate inside telemetry_hub.py global scope
LATTICE_AI = LatticePatternAI()
function updateOrCreateSpatialNode(index, x, y, z, label, amplitude) {
    if (nodeMap.has(index)) {
        const mesh = nodeMap.get(index);
        mesh.position.lerp(new THREE.Vector3(x, y, z), 0.1);
        return;
    }

    let geometry, color;

    // Mesh Geometry Allocation Trees
    if (index === 0) {
        geometry = new THREE.SphereGeometry(2.5, 32, 32);
        color = 0x39FF14; // Emerald Green Origin
    } else if (index === 5) {
        geometry = new THREE.OctahedronGeometry(2.0, 0);
        color = 0x00F0FF; // Worker 5 Creative Layer (Cyan)
    } else if (index >= 1 && index <= 8) {
        // Standard Workers 1-8 Block Allocations
        geometry = index === 1 ? new THREE.TorusGeometry(1.2, 0.3, 8, 24) : new THREE.ConeGeometry(0.8, 1.6, 4);
        color = index === 7 ? 0xF59E0B : 0x38BDF8; // Amber for Worker 7, Ocean Blue for others
    } else if (index === 1042 || index === 2048) {
        geometry = new THREE.BoxGeometry(1.6, 1.6, 1.6);
        color = 0xA78BFA; // Purple Core for Mark & Enoch
    } else {
        geometry = new THREE.ConeGeometry(0.5, 1.0, 4);
        color = 0x64748B; // Slate Gray for background bot infrastructure
    }

    const material = new THREE.MeshPhongMaterial({ 
        color: color, 
        shininess: index === 0 ? 150 : 80,
        wireframe: index > 900000
    });
    
    const mesh = new THREE.Mesh(geometry, material);
    mesh.position.set(x, y, z);
    scene.add(mesh);
    nodeMap.set(index, mesh);
}
