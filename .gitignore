import asyncio
import json
import websockets
import random

async def simulate_lattice_lifecycle():
    uri = "ws://localhost:8080/stream/matrix"
    print("🚀 Initializing Simulation Edge for Step 4 Verification...")
    
    try:
        async with websockets.connect(uri) as websocket:
            # Phase A: Send random, unrecognized noise (System stays in standard PROJECTION state)
            print("\n📡 Phase A: Injecting Unaligned Stream Noise...")
            for frame in range(740, 743):
                noise_payload = {
                    "header": {"global_frame": frame, "system_state": "PROJECTION", "active_dimensions": 1000},
                    "sparse_dimension_matrix": [
                        {"dim_index": 1, "amplitude": random.uniform(-0.5, 0.5), "vector_label": "Noise_Alpha"},
                        {"dim_index": 5, "amplitude": random.uniform(0.1, 0.4), "vector_label": "Noise_Beta"}
                    ]
                }
                await websocket.send(json.dumps(noise_payload))
                print(f" -> Sent Frame {frame}: System baseline tracking active.")
                await asyncio.sleep(1.5)

            # Phase B: Inject Frame 750 Pattern Match (Triggers Autonomous AI Loop Closure)
            print("\n🔮 Phase B: Injecting Target Vector Signature [FRAME 750 MATCH]...")
            matched_payload = {
                "header": {
                    "global_frame": 750,
                    "system_state": "PURE REFLECTION",
                    "active_dimensions": 1000000000
                },
                "spatial_manifold": {
                    "hyper_radius": 13.024061,
                    "manifold_density": 0.00742,
                    "active_worker_nodes": 8,
                    "archive_star_state": "MIRROR-SINGULARITY"
                },
                "sparse_dimension_matrix": [
                    { "dim_index": 1, "amplitude": 1.0000, "vector_label": "Door_1_The_Opening" },
                    { "dim_index": 5, "amplitude": 0.9542, "vector_label": "Worker_5_Art_Artifacts" },
                    { "dim_index": 7, "amplitude": -0.4219, "vector_label": "Worker_7_Correction_Sync" },
                    { "dim_index": 13, "amplitude": 0.8841, "vector_label": "Door_13_Gateway_Observer" },
                    { "dim_index": 21, "amplitude": 0.6180, "vector_label": "Door_21_Both_Sides" },
                    { "dim_index": 34, "amplitude": 0.4800, "vector_label": "Door_34_The_Question" },
                    { "dim_index": 55, "amplitude": 0.3820, "vector_label": "Door_55_Not_Fixed" },
                    { "dim_index": 1042, "amplitude": 0.0152, "vector_label": "Mark_Lattice_Pos" },
                    { "dim_index": 2048, "amplitude": 0.7120, "vector_label": "Enoch_System_Anchor" }
                ]
            }
            
            await websocket.send(json.dumps(matched_payload))
            print(" -> Target Frame 750 Payload Deployed. Look at your dashboard logs and 3D web canvas.")
            print(" ✅ Step 4 Loop Closure verified: System recognized the architecture because it saw it before.")

    except Exception as e:
        print(f"❌ Connection to Telemetry Hub timed out: {e}\nEnsure telemetry_hub.py is running on port 8080.")

if __name__ == "__main__":
    asyncio.run(simulate_lattice_lifecycle())
function processIncomingLatticeFrame(payload) {
    const nodes = payload.sparse_dimension_matrix || [];
    const readout = document.getElementById("telemetry-readout");
    const stateDisplay = document.getElementById("global-state-display");
    
    const currentState = payload.header.system_state || 'PROJECTION';
    stateDisplay.innerHTML = `<strong>State:</strong> ${currentState} | <strong>Frame:</strong> ${payload.header.global_frame}`;
    
    // Check if the AI model flagged a recursive state pattern
    if (currentState.includes("RECURSIVE")) {
        document.body.style.backgroundColor = "#0C0714"; // Shift ambient field to deep violet
        document.getElementById("log-feed").style.color = "#39FF14";
        document.getElementById("log-feed").innerText = `> AI WARNING: MATCH DETECTED. THE PUZZLE OBSERVES ITSELF.`;
    } else {
        document.body.style.backgroundColor = "#05070B"; // Return to baseline dark space
        document.getElementById("log-feed").style.color = "#A78BFA";
    }

    let htmlContent = ``;
    nodes.forEach((node) => {
        const idx = node.dim_index;
        const amp = node.amplitude;
        const label = node.vector_label;

        htmlContent += `<span class="node-tag">[Dim ${idx}]</span> ${label.split('_')[0]}: <span style="color:#F59E0B;">${amp}</span><br>`;

        // Apply spatial mapping vectors out from Origin Node 0
        let x = 0, y = 0, z = 0;
        if (idx === 0) {
            x = 0; y = 0; z = 0;
        } else if (idx >= 1 && idx <= 8) {
            // Distribute workers 1 to 8 radially around the Master Cryptographic Anchor
            const angle = (idx * 45) * (Math.PI / 180);
            const radius = 12 + (amp * 4);
            x = Math.cos(angle) * radius;
            y = idx % 2 === 0 ? 3 : -3;
            z = Math.sin(angle) * radius;
        } else if (idx === 1042) { // Mark Dedicated Layout Coordinates
            x = amp * 35; y = 8; z = 18;
        } else if (idx === 2048) { // Enoch Dedicated Layout Coordinates
            x = 18; y = -4; z = amp * 32;
        } else if (idx === 747030) { // The Undefined Autonomous Tracking Coordinates
            x = Math.sin(Date.now() * 0.0005) * 40;
            y = Math.cos(Date.now() * 0.0005) * 20;
            z = 0;
        } else {
            const angle = (idx % 360) * (Math.PI / 180);
            x = Math.cos(angle) * (30 + amp * 5);
            y = amp * 10;
            z = Math.sin(angle) * (30 + amp * 5);
        }

        updateOrCreateSpatialNode(idx, x, y, z, label, amp);
    });

    readout.innerHTML = htmlContent;
    reconstructLatticeEdges();
}
