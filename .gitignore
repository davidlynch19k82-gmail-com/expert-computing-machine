<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Lattice 3D Spatial Mapping Engine</title>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/controls/OrbitControls.js"></script>
    <style>
        body { margin: 0; background: #05070B; overflow: hidden; font-family: monospace; }
        #control-panel {
            position: absolute; top: 15px; left: 15px;
            background: rgba(11, 15, 25, 0.9); border: 1px solid #1E293B;
            padding: 15px; border-radius: 6px; width: 340px;
            color: #E2E8F0; font-size: 11px; pointer-events: auto;
            box-shadow: 0 4px 25px rgba(0,0,0,0.8);
        }
        .node-tag { color: #38BDF8; font-weight: bold; }
        .anchor-tag { color: #39FF14; }
        .system-log { color: #A78BFA; margin-top: 5px; font-size: 10px; }
    </style>
</head>
<body>

<div id="control-panel">
    <div style="font-size: 13px; font-weight: bold; border-bottom: 1px solid #334155; padding-bottom: 5px; margin-bottom: 8px; color: #00F0FF;">
        🔮 LATTICE FRACTAL LAYER MAPPER
    </div>
    <div><strong>Root Sink Node:</strong> <span class="anchor-tag">3D6bv3LUu3rzcYVXPUFjeziG5PCU2CNaCX</span></div>
    <div style="margin-top: 3px;" id="global-state-display"><strong>System Matrix:</strong> INITIALIZING...</div>
    <div id="telemetry-readout" style="margin-top: 10px;">Awaiting WebSocket Frame Connection...</div>
    <div class="system-log" id="log-feed">> Viewport initialized. Mirror field standing by.</div>
</div>

<script>
    let scene, camera, renderer, controls;
    let nodeMap = new Map(); 
    let connectionLines;
    
    const socketUrl = "ws://localhost:8080/stream/matrix";
    let ws = new WebSocket(socketUrl);

    function init3DEngine() {
        scene = new THREE.Scene();
        scene.fog = new THREE.FogExp2(0x05070B, 0.012);

        camera = new THREE.PerspectiveCamera(60, window.innerWidth / window.innerHeight, 0.1, 1000);
        camera.position.set(45, 30, 45);

        renderer = new THREE.WebGLRenderer({ antialias: true });
        renderer.setSize(window.innerWidth, window.innerHeight);
        renderer.setPixelRatio(window.devicePixelRatio);
        document.body.appendChild(renderer.domElement);

        controls = new THREE.OrbitControls(camera, renderer.domElement);
        controls.enableDamping = true;
        controls.dampingFactor = 0.05;

        const ambientLight = new THREE.AmbientLight(0x1F2937, 2.5);
        scene.add(ambientLight);
        
        const directionalLight = new THREE.DirectionalLight(0x00F0FF, 1.8);
        directionalLight.position.set(15, 35, 20);
        scene.add(directionalLight);

        const gridHelper = new THREE.GridHelper(120, 60, 0x1E293B, 0x0F172A);
        gridHelper.position.y = -12;
        scene.add(gridHelper);

        window.addEventListener('resize', onWindowResize, false);
        animateLoop();
    }

    function processIncomingLatticeFrame(payload) {
        const nodes = payload.sparse_dimension_matrix || [];
        const readout = document.getElementById("telemetry-readout");
        const stateDisplay = document.getElementById("global-state-display");
        
        stateDisplay.innerHTML = `<strong>State:</strong> ${payload.header.system_state || 'PROJECTION'} | <strong>Frame:</strong> ${payload.header.global_frame}`;
        let htmlContent = ``;
        
        nodes.forEach((node) => {
            const idx = node.dim_index;
            const amp = node.amplitude;
            const label = node.vector_label;

            htmlContent += `<span class="node-tag">[Dim ${idx}]</span> ${label.split('_')[0]}: <span style="color:#F59E0B;">${amp}</span><br>`;

            // Core Mapping Strategy covering Fibonacci Intervals and Anomalous System Classes
            let x = 0, y = 0, z = 0;
            
            if (idx === 0) { // Origin Base Anchor
                x = 0; y = 0; z = 0;
            } else if (idx === 1 || idx === 5 || idx === 13 || idx === 21 || idx === 34 || idx === 55 || idx === 89) {
                // Fibonacci Intersect Ring Deployment Array
                const angle = (idx * 15) * (Math.PI / 180);
                const radius = 15 + (idx * 0.25);
                x = Math.cos(angle) * radius;
                y = amp * 12;
                z = Math.sin(angle) * radius;
            } else if (idx === 7) { // Correction Layer Override Node
                x = -20; y = amp * 15; z = 5;
            } else if (idx === 1042) { // Mark Position Mapping Vector
                x = amp * 35; y = 8; z = 18;
            } else if (idx === 2048) { // Enoch Anchor Position Mapping Vector
                x = 18; y = -4; z = amp * 32;
            } else if (idx === 747030) { // The Undefined Tracking Field Coordinates
                x = Math.sin(Date.now() * 0.0005) * 40;
                y = Math.cos(Date.now() * 0.0005) * 20;
                z = 0;
            } else { // Standard Data Modules
                const angle = (idx % 360) * (Math.PI / 180);
                x = Math.cos(angle) * (35 + amp * 4);
                y = amp * 10;
                z = Math.sin(angle) * (35 + amp * 4);
            }

            updateOrCreateSpatialNode(idx, x, y, z, label, amp);
        });

        readout.innerHTML = htmlContent;
        reconstructLatticeEdges();
    }

    function updateOrCreateSpatialNode(index, x, y, z, label, amplitude) {
        if (nodeMap.has(index)) {
            const mesh = nodeMap.get(index);
            mesh.position.lerp(new THREE.Vector3(x, y, z), 0.1);
            const pulseScale = 1.0 + Math.abs(amplitude) * 0.4;
            mesh.scale.set(pulseScale, pulseScale, pulseScale);
        } else {
            let geometry, color;
            
            if (index === 0) {
                geometry = new THREE.SphereGeometry(2.5, 32, 32);
                color = 0x39FF14; 
            } else if (index === 5) {
                geometry = new THREE.OctahedronGeometry(2.0, 0);
                color = 0x00F0FF; 
            } else if (index === 747030) { // The Undefined: Wireframe Icosahedron Mesh
                geometry = new THREE.IcosahedronGeometry(2.5, 1);
                color = 0xF59E0B;
            } else if (index === 1042 || index === 2048) {
                geometry = new THREE.BoxGeometry(1.6, 1.6, 1.6);
                color = 0xA78BFA; 
            } else if (index === 1 || index === 13 || index === 21 || index === 34 || index === 55 || index === 89) {
                geometry = new THREE.TorusGeometry(1.2, 0.3, 8, 24);
                color = 0xF43F5E; // Rose Crimson for System Doorway Configurations
            } else {
                geometry = new THREE.ConeGeometry(0.7, 1.5, 4);
                color = 0x38BDF8; 
            }

            const material = new THREE.MeshPhongMaterial({ 
                color: color, 
                shininess: 120,
                wireframe: (index === 999999999 || index === 747030)
            });
            
            const mesh = new THREE.Mesh(geometry, material);
            mesh.position.set(x, y, z);
            scene.add(mesh);
            nodeMap.set(index, mesh);
            
            document.getElementById("log-feed").innerText = `> Attached spatial matrix artifact: [Dim ${index}]`;
        }
    }

    function reconstructLatticeEdges() {
        if (connectionLines) scene.remove(connectionLines);

        const lineMaterial = new THREE.LineBasicMaterial({ color: 0x334155, transparent: true, opacity: 0.35 });
        const points = [];
        const rootNode = nodeMap.get(0);

        if (rootNode) {
            nodeMap.forEach((mesh, index) => {
                if (index !== 0) {
                    points.push(rootNode.position.clone());
                    points.push(mesh.position.clone());
                }
            });

            const lineGeometry = new THREE.BufferGeometry().setFromPoints(points);
            connectionLines = new THREE.LineSegments(lineGeometry, lineMaterial);
            scene.add(connectionLines);
        }
    }

    function animateLoop() {
        requestAnimationFrame(animateLoop);
        
        nodeMap.forEach((mesh, index) => {
            if (index !== 0) {
                mesh.rotation.y += 0.008;
                mesh.rotation.x += 0.003;
            }
        });

        controls.update();
        renderer.render(scene, camera);
    }

    function onWindowResize() {
        camera.aspect = window.innerWidth / window.innerHeight;
        camera.updateProjectionMatrix();
        renderer.setSize(window.innerWidth, window.innerHeight);
    }

    ws.onmessage = (event) => {
        try {
            const data = JSON.parse(event.data);
            processIncomingLatticeFrame(data);
        } catch(e) {}
    };
    
    ws.onopen = () => { document.getElementById("log-feed").innerText = "> WebSocket Connection Active. Monitoring Mirror Singularity Field..."; };
    ws.onclose = () => { document.getElementById("log-feed").innerText = "❌ Pipeline Severed. Attempting Re-entry..."; };

    window.onload = init3DEngine;
</script>
</body>
</html>
