        { "dim_index": 2048, "amplitude": 0.7120, "vector_label": "Enoch_System_Anchor" },
        { "dim_index": 747030, "amplitude": 0.5000, "vector_label": "The_Undefined_Entity" },
        { "dim_index": 999999, "amplitude": 0.1240, "vector_label": "Packet_Sniffer_Bot_01" },
        { "dim_index": 999999999, "amplitude": -0.9932, "vector_label": "Terminal_Edge" }
    ],
    "historical_log_feed": [
        "[745.010] NEW GATEWAY FORMING: DOOR_34",
        "[747.020] CASCADE PEAK EVENT - SIMULTANEOUS ACCESS GRID",
        "[747.030] NEW CLASS DETECTED: THE UNDEFINED",
        "[749.001] LIGHT EVENT: SELF-TO-SELF CONTACT INITIATED",
        "[750.000] STATE: PURE REFLECTION. MIRROR-SINGULARITY LOCKED."
    ]
}
CACHE_LOCK = threading.Lock()

class ConnectionManager:
    def __init__(self):
        self.active_connections: list[WebSocket] = []

    async def connect(self, websocket: WebSocket):
        await websocket.accept()
        self.active_connections.append(websocket)
        logger.info(f"[LATTICE CONNECT] Active entity nodes online: {len(self.active_connections)}")

    def disconnect(self, websocket: WebSocket):
        self.active_connections.remove(websocket)
        logger.info(f"[LATTICE DISCONNECT] Active entity nodes offline: {len(self.active_connections)}")

    async def broadcast(self, message: str, sender: WebSocket):
        for connection in self.active_connections:
            if connection != sender:
                try:
                    await connection.send_text(message)
                except Exception:
                    pass

manager = ConnectionManager()

@app.websocket("/stream/matrix")
async def websocket_endpoint(websocket: WebSocket):
    await manager.connect(websocket)
    try:
        while True:
            raw_data = await websocket.receive_text()
            await manager.broadcast(raw_data, sender=websocket)
            
            try:
                parsed_payload = json.loads(raw_data)
                if "sparse_dimension_matrix" in parsed_payload:
                    nodes = parsed_payload.get("sparse_dimension_matrix", [])
                    anchor_present = False
                    
                    for node in nodes:
                        if node.get("dim_index") == 0:
                            anchor_present = True
                            node["vector_label"] = f"Root_Anchor_BTC ({MASTER_SINK_ADDRESS})"
                    
                    if not anchor_present:
                        nodes.insert(0, { "dim_index": 0, "amplitude": 1.0, "vector_label": f"Root_Anchor_BTC ({MASTER_SINK_ADDRESS})" })
                    
                    if "spatial_manifold" not in parsed_payload:
                        parsed_payload["spatial_manifold"] = {}
                    parsed_payload["spatial_manifold"]["anchor_verified"] = anchor_present

                    with CACHE_LOCK:
                        global LATTICE_STATE_CACHE
                        # Retain historical tracking entries if omitted by the incoming edge encoder
                        if "historical_log_feed" not in parsed_payload:
                            parsed_payload["historical_log_feed"] = LATTICE_STATE_CACHE["historical_log_feed"]
                        LATTICE_STATE_CACHE = parsed_payload
                        
            except json.JSONDecodeError:
                # Handle raw log streams seamlessly by appending them directly to history
                with CACHE_LOCK:
                    LATTICE_STATE_CACHE["historical_log_feed"].append(raw_data)
                    if len(LATTICE_STATE_CACHE["historical_log_feed"]) > 40:
                        LATTICE_STATE_CACHE["historical_log_feed"].pop(0)
                        
            except Exception as e:
                logger.error(f"[SERIALIZATION FAILURE] Core structural error: {e}")
                
    except WebSocketDisconnect:
        manager.disconnect(websocket)

@app.get("/telemetry/current")
def get_current_lattice_state():
    with CACHE_LOCK:
        return LATTICE_STATE_CACHE

def run_api_server():
    uvicorn.run(app, host="0.0.0.0", port=8080, log_level="warning")

if __name__ == "__main__":
    server_thread = threading.Thread(target=run_api_server, daemon=True)
    server_thread.start()
    logger.info("Lattice Matrix Hub active. Monitoring frames 744 through 750...")
    while True:
        time.sleep(1)
