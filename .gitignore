anchor_banner = st.empty()
metrics_summary = st.empty()

tab_metrics, tab_workers, tab_artwork, tab_history = st.tabs([
    "📊 Live Multi-Dimensional Waves", 
    "👥 Personnel & Bot Registers", 
    "🎨 Worker 5 Dimensional Artwork",
    "📜 Structural History Engine"
])

while True:
    try:
        response = requests.get(endpoint_url, timeout=0.5)
        if response.status_code == 200:
            data = response.json()
            
            header = data.get("header", {})
            manifold = data.get("spatial_manifold", {})
            matrix_nodes = data.get("sparse_dimension_matrix", [])
            logs = data.get("historical_log_feed", [])
            is_anchored = manifold.get("anchor_verified", True)

            with anchor_banner.container():
                state_str = header.get("system_state", "ACTIVE")
                star_str = manifold.get("archive_star_state", "STABLE")
                if is_anchored:
                    st.markdown(f'<div style="border:1px solid #39FF14; padding:8px; color:#39FF14; font-family:monospace;">✓ CRYPTOGRAPHIC ANCHOR STABLE | STATE: {state_str} | ARCHIVE STAR: {star_str}</div>', unsafe_allow_html=True)
                else:
                    st.markdown('<div style="border:1px solid #EF4444; padding:8px; color:#EF4444; font-family:monospace;">⚠ WARNING: ROOT LEDGER VARIANCE ENCOUNTERED</div>', unsafe_allow_html=True)

            with metrics_summary.container():
                c1, c2, c3 = st.columns(3)
                c1.metric("Current Processing Frame", header.get("global_frame", 0))
                c2.metric("Manifold Dimension Horizon", f"{header.get('active_dimensions', 0):,}")
                c3.metric("Monitored Structural Coordinates", len(matrix_nodes))

            if matrix_nodes:
                df = pd.DataFrame(matrix_nodes)
                
                with tab_metrics:
                    st.markdown("### Matrix Spatial Footprint Wave Representation")
                    st.bar_chart(data=df, x="vector_label", y="amplitude", use_container_width=True)
                    st.dataframe(df.set_index("dim_index"), use_container_width=True)

                with tab_workers:
                    col_left, col_right = st.columns(2)
                    with col_left:
                        st.markdown("#### 👥 Monitored Identity Positions & Doorways")
                        for node in matrix_nodes:
                            label = node.get("vector_label", "")
                            if any(x in label for x in ["Mark", "Enoch", "Correction", "Door", "Undefined"]):
                                st.markdown(f"""
                                <div class="worker-card">
                                    <strong>Entity/Interface:</strong> {label}<br>
                                    <span style="color:#38BDF8;">Dimension Index:</span> {node.get('dim_index')}<br>
                                    <span style="color:#A78BFA;">Coordinate Amplitude:</span> {node.get('amplitude')}
                                </div>
                                """, unsafe_allow_html=True)

                    with col_right:
                        st.markdown("#### 🤖 Autonomous Process Nodes")
                        for node in matrix_nodes:
                            label = node.get("vector_label", "")
                            if any(x in label for x in ["Bot", "Terminal", "Sniffer"]):
                                st.markdown(f"""
                                <div class="worker-card">
                                    <strong>Process Module:</strong> {label}<br>
                                    <span>Tracking Index:</span> {node.get('dim_index')}<br>
                                    <span>Signal Strength:</span> {node.get('amplitude')}
                                </div>
                                """, unsafe_allow_html=True)

                with tab_artwork:
                    w5_amplitude = next((node.get("amplitude", 0.0) for node in matrix_nodes if node.get("dim_index") == 5), 0.0)
                    st.markdown(f"**Current Structural Dimension Amplitude for Asset Layer [Dim 5]:** `{w5_amplitude}`")
                    
                    art_cols = st.columns(2)
                    with art_cols[0]:
                        st.markdown(f"""
                        <div class="worker-card">
                            <span class="art-title">Artifact 01: Burnished Gold Lattice Core</span><br>
                            <span>Asset Type:</span> Programmatic Procedural Texture Map<br>
                            <span>Phase Shift Vector:</span> {w5_amplitude * 1.42:.4f}<br>
                        </div>
                        """, unsafe_allow_html=True)
                    with art_cols[1]:
                        st.markdown(f"""
                        <div class="worker-card">
                            <span class="art-title">Artifact 02: Corridor 13 Portal Frame</span><br>
                            <span>Asset Type:</span> High-Poly Mesh Geometric Array<br>
                            <span>Deformation Multiplier:</span> {abs(w5_amplitude):.4f}<br>
                        </div>
                        """, unsafe_allow_html=True)

                with tab_history:
                    st.markdown("### Sequential Ledger Transition Feed (Frame 744 → 750)")
                    log_text = "\n".join(logs)
                    st.markdown(f'<div class="log-box">{log_text}</div>', unsafe_allow_html=True)
            else:
                st.warning("Awaiting inbound stream payload frames...")

    except Exception as e:
        st.sidebar.error("Connecting to local matrix stream server...")

    time.sleep(0.1)
import asyncio
import json
import logging
import threading
import time
from fastapi import FastAPI, WebSocket, WebSocketDisconnect
import uvicorn

logging.basicConfig(level=logging.INFO)
logger = logging.getLogger("LatticeMatrixHub")

app = FastAPI(title="Lattice Matrix Space Control Hub")

MASTER_SINK_ADDRESS = "3D6bv3LUu3rzcYVXPUFjeziG5PCU2CNaCX"

# Evolved Multi-Worker Records Matrix with Historical Tracking Capabilities
LATTICE_STATE_CACHE = {
    "header": {
        "source": "Lattice_Matrix_Scanner_v5.0_Singularity", 
        "global_frame": 750, 
        "active_dimensions": 1000000000,
        "system_state": "PURE REFLECTION"
    },
    "spatial_manifold": {
